; Phase 0 probe project: proves a generated GLB imports and loads in headless Godot, and that
; the project's shader includes actually compile.
; Kept deliberately minimal - it is a gate, not a game.

config_version=5

[application]

config/name="Phase0Probe"
run/main_scene="res://probe.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

; The game ships on the Mobile renderer (see README). This probe project deliberately uses
; Compatibility instead: it is the renderer that compiles the shading language deterministically
; on a CPU-only runner with no GPU and no Vulkan driver, so it is the only one that can gate the
; shader includes in CI at all. Mobile-renderer compilation is therefore NOT proven here — it is
; part of the real-device check, and reports/quality_report.md lists it as a weaker check.
renderer/rendering_method="gl_compatibility"

; Shader globals, matching shaders/SHADER_GLOBALS.md.
;
; Godot requires every `global uniform` to be registered here before a shader using it will
; compile; a default written in the shader is ignored. Without these the wind and wetness
; includes cannot be compiled at all, which is why the shader compile probe needs them.
[shader_globals]

global_wetness={
"type": "float",
"value": 0.0
}
puddle_amount={
"type": "float",
"value": 0.0
}
wind_time={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.6
}
wind_gust={
"type": "float",
"value": 0.0
}

