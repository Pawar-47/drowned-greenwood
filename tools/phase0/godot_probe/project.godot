; Phase 0 probe project: proves a generated GLB imports and loads in headless Godot.
; Kept deliberately minimal - it is a gate, not a game.

config_version=5

[application]

config/name="Phase0Probe"
run/main_scene="res://probe.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
