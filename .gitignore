# Never committed (see the brief, section 2B)
*.blend
*.blend1
*.blend2
# Source HDRIs and high-bit-depth texture sources are never committed: they are large, and the
# pipeline bakes them down to 1K-2K tiles before anything ships.
*.hdr
*.exr
# Anchored to the repository root. Without the leading slash these also matched a directory
# named "build" or "out" anywhere in the tree, including inside tools/.
/staging/
/build/
/out/
/tmp/
artifacts/
phase0_log.txt

# Godot import cache and build output
.godot/
export_presets.cfg.bak
*.apk
*.aab
# The Phase 0 shader probe copies the real shaders in at run time and rewrites their include
# paths; these are generated, never committed.
tools/phase0/godot_probe/includes/
tools/phase0/godot_probe/terrain_hydrology_mask.png
tools/phase0/godot_probe_*/

# Generated from assets/manifest.json by tools/build_manifest.py
assets/manifest.expanded.json

# Downloaded tools and archives (fetched fresh in CI, cached by actions/cache)
tools/vendor/
*.tar.xz
*.tar.gz
*.zip

# Packed assets, downloaded from a GitHub Release by tools/fetch_packs.py and listed in
# assets/packs.json. A binary in git is permanent — deleting it later leaves the blob in history —
# so the terrain maps are not tracked at all. assets/built.json still names these exact paths, and
# fetch_packs.py puts the bytes back before any check or build needs them.
assets/terrain/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
*.swp
