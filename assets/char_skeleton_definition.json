{
  "schema_version": 1,
  "name": "char_skeleton_definition",
  "description": "The one humanoid skeleton every character, clothing piece, armor piece and animation in The Drowned Greenwood binds to. Written in Phase 1, before any human or animation work, so nothing can invent a second skeleton later.",
  "constraints": {
    "max_bones": 65,
    "max_weights_per_vertex": 4,
    "weights_normalized": true,
    "animation_fps": 30,
    "no_scale_keys": true,
    "loop_seam_tolerance": {
      "rotation_degrees": 1.0,
      "position_cm": 1.0
    }
  },
  "bone_count": 56,
  "bone_budget_note": "56 of the 65 allowed bones. The 9 spare are deliberately unallocated: cloth chains (cape, banner, tabard) are separate tech_cloth_bone_chain_* assets with their own <= 6-bone chains, so they must not eat this budget.",
  "units": "metres, Y-up, character faces -Z in rest pose",
  "rest_pose": {
    "type": "T-pose",
    "arms": "straight out along X, palms down",
    "legs": "straight down, feet flat, toes forward",
    "reason": "T-pose rather than A-pose because the CC0 animation libraries we retarget from are authored in T-pose; matching their rest pose removes a whole class of retarget error."
  },
  "godot_profile": {
    "profile": "SkeletonProfileHumanoid",
    "note": "Bone names below ARE the Godot SkeletonProfileHumanoid bone names, deliberately. Godot's retargeting matches by name against the profile, so inventing our own names would mean maintaining a translation layer for no benefit. This also means Godot's own retarget tools work on our clips without configuration."
  },
